{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageSimulatorManifest",
  "type": "object",
  "required": ["manifests"],
  "properties": {
    "manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "boot_stage",
          "lang",
          "input_contract",
          "marker_contract",
          "allowed_side_effects"
        ],
        "properties": {
          "module_id": {"type": "string"},
          "boot_stage": {"type": "string"},
          "lang": {"type": "string", "enum": ["assembly", "c++"]},
          "input_contract": {"type": "string"},
          "marker_contract": {"type": "string"},
          "allowed_side_effects": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
